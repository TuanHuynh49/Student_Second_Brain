# ==============================================================================
# STUDENT SECOND BRAIN - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Hướng dẫn: Sao chép tệp này thành .env và điền các khóa API của bạn trước khi chạy.
# Lệnh copy: cp .env.example .env (Linux/macOS) hoặc copy .env.example .env (Windows)

# 1. Cấu hình mô hình ngôn ngữ (OpenAI API / Compatible Proxy Endpoints)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
MODEL=gpt-4o-mini

# 2. Cấu hình kho dữ liệu học tập (Data & Ingestion)
DOC_PATH=data/raw
INDEX_SOURCE=document_store_cache.json

# 3. Cấu hình mô hình Embedding (Dense Retrieval)
MODEL_EMBEDING=jina-embeddings-v3
JINA_API_KEY=your_jina_api_key_here

# 4. Cấu hình Reranker & Đánh giá RAG (Cross-Encoder / LLM Evaluator)
MODEL_RERANK=cross-encoder/ms-marco-MiniLM-L-6-v2
GROQ_API_KEY=your_groq_api_key_here

# 5. Cấu hình giá token (USD per 1 million tokens) - dùng để tính chi phí API
INPUT_PRICE_PER_MILLION=2
OUTPUT_PRICE_PER_MILLION=10
